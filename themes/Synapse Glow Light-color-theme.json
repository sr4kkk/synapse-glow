  // ================================
  // SINTAXE (TOKEN COLORS - TextMate)
  // ================================
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7E8493",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#B445FF"
      }
    },
    {
      "name": "Types & Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#2687C9"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function",
        "meta.method",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#1F6FB2"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable.name", "support.variable"],
      "settings": {
        "foreground": "#1D1E24"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#596075"
      }
    },
    {
      "name": "Constants & Numbers",
      "scope": ["constant", "constant.numeric", "support.constant"],
      "settings": {
        "foreground": "#C08800"
      }
    },
    {
      "name": "Booleans",
      "scope": ["constant.language.boolean", "constant.boolean"],
      "settings": {
        "foreground": "#D56761"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "constant.other.symbol", "constant.other.key"],
      "settings": {
        "foreground": "#C08800"
      }
    },
    {
      "name": "Template / Interpolation",
      "scope": [
        "string.template",
        "string.quoted.template",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#8A5A00"
      }
    },
    {
      "name": "Operators & Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition"
      ],
      "settings": {
        "foreground": "#4D5160"
      }
    },
    {
      "name": "Tags (HTML, JSX, XML)",
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#E05256"
      }
    },
    {
      "name": "Tag Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx"
      ],
      "settings": {
        "foreground": "#B445FF"
      }
    },
    {
      "name": "Property Keys / Object Keys",
      "scope": [
        "meta.object-literal.key",
        "meta.object-literal.key entity.name",
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#2687C9"
      }
    },
    {
      "name": "Imports & Modules",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "meta.import",
        "meta.export",
        "support.module",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#00B7A9"
      }
    },
    {
      "name": "Decorators & Annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#2687C9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid / Errors",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#E05256"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": {
        "foreground": "#2FCD82",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Links",
      "scope": ["string.other.link", "constant.other.reference.link", "markup.underline.link"],
      "settings": {
        "foreground": "#2687C9",
        "fontStyle": "underline"
      }
    }
  ],

  // ================================
  // SEMANTIC TOKEN COLORS (mais preciso em TS/JS)
  // ================================
  "semanticTokenColors": {
    "comment": { "foreground": "#7E8493", "italic": true },

    "keyword": "#B445FF",
    "string": "#C08800",
    "number": "#C08800",

    "function": "#1F6FB2",
    "method": "#1F6FB2",

    "class": "#2687C9",
    "interface": "#2687C9",
    "type": "#2687C9",

    "parameter": "#596075",
    "variable": "#1D1E24",
    "property": "#2687C9",

    "enum": "#2687C9",
    "enumMember": "#C08800",

    "namespace": "#00B7A9",
    "typeParameter": "#2687C9"
  }
}
